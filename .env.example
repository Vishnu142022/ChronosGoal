# API Base URL (Frontend -> Backend, e.g. /api or http://localhost:8080/discipline-api/api for Java Servlets)
VITE_API_BASE_URL=/api

# Frontend development server
PORT=3000
NODE_ENV=production

# Java Servlet backend (Tomcat)
DB_URL=jdbc:mysql://localhost:3306/discipline_os_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=root
DB_PASSWORD=replace-with-your-mysql-password

# Admin bootstrap/recovery credentials.
# Set these in the Java/Tomcat process environment as well. The first matching
# sign-in creates the admin if missing, or repairs its password hash if needed.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password

